# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# velite generated content
.velite
.gstack/

# Private working notes (daily logs, scratch) — never commit
scratch-pad/

# Playwright E2E test output
test-results/
playwright-report/

# Agent-tooling state (claude-flow / Ruflo). Written into the CURRENT working
# directory, so a `cd` into any subdirectory drops a second copy there too.
# ~3.8 MB of regenerable binaries — never commit.
ruvector.db
agentdb.rvf
agentdb.rvf.*
.swarm/
.claude-flow/
